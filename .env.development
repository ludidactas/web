NEXT_PUBLIC_ENCUESTA_HOST=http://localhost:3005

# Para probar por LAN, pisar inline con la IP de la máquina (procesos idp y app).
IDP_HOST=localhost

# Firma/verifica el token del WSS (Next firma, el wss verifica). Distinto del secreto de sesión.
WSS_TOKEN_SECRET=dev-secreto-token-wss

# Clave HMAC de los ids opacos por sala (eventos de Go hacia los clientes). Fija en dev: no es secreto real.
SECRETO_ID_OPACO=dev-secreto-id-opaco
